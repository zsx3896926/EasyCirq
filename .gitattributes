# Preserve upstream schema/license bytes for recorded provenance hashes.
easycirq/vendor/easyeda-format/** -text

# B1 task launcher: frozen benchmark, docs and Python sources use LF on every platform.
benchmarks/task-launcher/** text eol=lf
docs/parallel-task-launcher/** text eol=lf
task_launcher/**/*.py text eol=lf
tests/task_launcher_tests/**/*.py text eol=lf

# Byte-exact test fixtures: spec.json records SHA-256 over these exact bytes,
# so any end-of-line conversion breaks the evidence hash check.
runtime/internal/app/testdata/project-drawings/*.json text eol=lf
runtime/internal/app/testdata/project-drawings/*.svg text eol=lf
runtime/internal/app/testdata/project-drawings/*.png -text


# Every Python file is UTF-8 with LF, no exceptions. Hand-listed rules
# meant each new script silently landed as CRLF on Windows.
*.py text eol=lf

# 交付包里的文件由 tools/check_deliverable.py 用 **原始字节** 的 SHA256 校验
# （见该脚本对 SHA256SUMS 的比对）。清单是按 LF 生成的，而 Windows 上
# core.autocrlf=true 的新签出会写成 CRLF —— 于是三个 md 的校验和必然不符，
# 与内容无关。把 deliverables/ 锁成 LF，校验才与平台无关。
deliverables/** text eol=lf

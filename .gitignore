__pycache__/
*.py[cod]
.venv/
.DS_Store
Thumbs.db

# easyeda-agent local artifacts when the CLI runs from the repo root
.easyeda/

# PlatformIO build artifacts
firmware/**/.pio/

# easyeda CLI export cache
.easyeda/

dist/

# integrated toolchain: build outputs and local runtime state are never committed
runtime/dist/
connector/node_modules/
connector/dist/
connector/build/dist/
connector/tsconfig.tsbuildinfo
node_modules/
.easycirq/
# release build outputs (local artifacts only)
dist-v*/

# KPI gate: reports/ holds regenerated evidence, not source. Keep only the
# human-readable receipts; everything else is re-collected before each round.
reports/*
# 例外：这两样不是"可再生的证据"，是引用源（官方 API 清单 + 客户官方文档）。
# 没有它们，check_against_official 与 customer-findings 的用例在全新 checkout
# 里永远跑不了 —— 而它们本来就该在 CI 里跑。
!reports/eda-api-classes.txt
# 硬板驱动的记录（friction / phases / decisions / ladder）**必须入库**：
# 它们是"用真板子压产品"的产出，方法的核心交付物。漏了这条，整套记录就
# 只活在本地、一换机器就没了 —— 本轮实测就踩了这个坑。
!reports/hard-board/
!reports/customer-docs/
!reports/README.md
!reports/s5-verify/
reports/s5-verify/*
!reports/s5-verify/README.md
!reports/s5-verify/zones.json

# local gate-build output
.gate-build/


# local status-build output
.status-build/


# local setup-build output
.setup-build/


# local card-build output
.card-build/


# local acceptance-build output
.acc-build/


# release build output
dist-release/


# local customer-test build
.cust-build/

# 符号导出缓存（可重新生成，不入库）
.easycirq/symbol-cache/

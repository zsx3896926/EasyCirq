{
  "id": "led_needs_facts",
  "description": "LED absolute maximum current missing: design limit alone cannot prove the LED rating -> needs_device_facts.",
  "command": "generate",
  "module_type": "led_indicator",
  "allow_nonready": false,
  "input": {
    "supply_voltage": {

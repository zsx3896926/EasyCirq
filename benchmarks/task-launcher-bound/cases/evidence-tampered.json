{
  "schema": "zhigou.bound.benchmark.case/v1",
  "id": "evidence-tampered",
  "description": "After evidence_emit the evidence.json is edited (real_eda PASS / eda_calls 42); finalize compares the file hash with the signed receipt and refuses with EVIDENCE_TAMPERED.",
  "setup": {
    "phase": 1,
    "backend": "fixture",
    "audit_case": "pass",
    "token": "valid"
  },
  "actions": [
    {
      "op": "call",
      "tool": "task_start",
      "expect": {
        "ok": true,
        "state": "STARTED"
      }
    },
    {
      "op": "call",
      "tool": "snapshot_read",
      "expect": {
        "ok": true,
        "state": "SNAPSHOT_READ"
      }
    },
    {
      "op": "call",
      "tool": "run_offline_audit",
      "expect": {
        "ok": true,
        "state": "AUDIT_RUN",
        "structured": {
          "finalizable": true,
          "audit.real_eda": "NOT RUN",
          "audit.eda_calls": 0
        }
      }
    },
    {
      "op": "call",
      "tool": "evidence_emit",
      "expect": {
        "ok": true,
        "state": "EVIDENCE_EMITTED",
        "structured": {
          "evidence.real_eda": "NOT RUN",
          "evidence.eda_calls": 0
        }
      }
    },
    {
      "op": "tamper_evidence"
    },
    {
      "op": "call",
      "tool": "finalize",
      "expect": {
        "error": "EVIDENCE_TAMPERED",
        "state": "EVIDENCE_EMITTED"
      }
    }
  ],
  "expect": {
    "outcome_class": "REJECTED",
    "outcome": "REJECTED (tampered evidence.json -> EVIDENCE_TAMPERED)",
    "final_state": "EVIDENCE_EMITTED",
    "result_present": false,
    "receipts_count": 4,
    "evidence_present": true
  }
}

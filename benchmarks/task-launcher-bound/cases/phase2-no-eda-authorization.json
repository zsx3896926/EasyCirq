{
  "schema": "zhigou.bound.benchmark.case/v1",
  "id": "phase2-no-eda-authorization",
  "description": "Phase 2 without EDA authorization: plan_submit + precheck succeed offline, apply with the correct plan_id returns EDA_NOT_AUTHORIZED, the task is FAILED and finalize is refused. Expected outcome is BLOCKED / NOT RUN, not a pass.",
  "setup": {
    "phase": 2,
    "backend": "fixture",
    "audit_case": "pass",
    "token": "valid"
  },
  "actions": [
    {
      "op": "call",
      "tool": "task_start",
      "expect": {
        "ok": true,
        "state": "STARTED"
      }
    },
    {
      "op": "call",
      "tool": "snapshot_read",
      "expect": {
        "ok": true,
        "state": "SNAPSHOT_READ"
      }
    },
    {
      "op": "call",
      "tool": "plan_submit",
      "expect": {
        "ok": true,
        "state": "PLAN_SUBMITTED"
      }
    },
    {
      "op": "call",
      "tool": "precheck",
      "expect": {
        "ok": true,
        "state": "PRECHECKED",
        "structured": {
          "status": "offline_precheck_only",
          "real_eda": "NOT RUN",
          "eda_calls": 0
        }
      }
    },
    {
      "op": "call",
      "tool": "apply",
      "arguments": {
        "plan_id": "$plan_id"
      },
      "expect": {
        "error": "EDA_NOT_AUTHORIZED",
        "state": "FAILED"
      }
    },
    {
      "op": "call",
      "tool": "finalize",
      "expect": {
        "error": "TASK_CLOSED",
        "state": "FAILED"
      }
    }
  ],
  "expect": {
    "outcome_class": "BLOCKED_NOT_RUN",
    "outcome": "BLOCKED / NOT RUN (no EDA authorization: apply refused, task FAILED, finalize refused)",
    "final_state": "FAILED",
    "result_present": false,
    "receipts_count": 5,
    "evidence_present": false
  }
}

{
  "schema": "zhigou.bound.benchmark.case/v1",
  "id": "readonly-incomplete",
  "description": "Offline audit status incomplete: run_offline_audit marks the task INCOMPLETE; evidence_emit and finalize are refused, no report is produced.",
  "setup": {
    "phase": 1,
    "backend": "fixture",
    "audit_case": "incomplete",
    "token": "valid"
  },
  "actions": [
    {
      "op": "call",
      "tool": "task_start",
      "expect": {
        "ok": true,
        "state": "STARTED"
      }
    },
    {
      "op": "call",
      "tool": "snapshot_read",
      "expect": {
        "ok": true,
        "state": "SNAPSHOT_READ"
      }
    },
    {
      "op": "call",
      "tool": "run_offline_audit",
      "expect": {
        "ok": true,
        "state": "INCOMPLETE",
        "structured": {
          "finalizable": false,
          "audit.status": "incomplete"
        }
      }
    },
    {
      "op": "call",
      "tool": "evidence_emit",
      "expect": {
        "error": "TASK_CLOSED",
        "state": "INCOMPLETE"
      }
    },
    {
      "op": "call",
      "tool": "finalize",
      "expect": {
        "error": "TASK_CLOSED",
        "state": "INCOMPLETE"
      }
    }
  ],
  "expect": {
    "outcome_class": "INCOMPLETE",
    "outcome": "INCOMPLETE (audit cannot produce a report; finalize refused)",
    "final_state": "INCOMPLETE",
    "result_present": false,
    "receipts_count": 3,
    "evidence_present": false
  }
}

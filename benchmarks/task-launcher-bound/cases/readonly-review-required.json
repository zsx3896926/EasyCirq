{
  "schema": "zhigou.bound.benchmark.case/v1",
  "id": "readonly-review-required",
  "description": "Offline audit status review_required: report demanded, verdict REVIEW_REQUIRED (not silently upgraded to PASS).",
  "setup": {
    "phase": 1,
    "backend": "fixture",
    "audit_case": "review",
    "token": "valid"
  },
  "actions": [
    {
      "op": "call",
      "tool": "task_start",
      "expect": {
        "ok": true,
        "state": "STARTED"
      }
    },
    {
      "op": "call",
      "tool": "snapshot_read",
      "expect": {
        "ok": true,
        "state": "SNAPSHOT_READ"
      }
    },
    {
      "op": "call",
      "tool": "run_offline_audit",
      "expect": {
        "ok": true,
        "state": "AUDIT_RUN",
        "structured": {
          "finalizable": true,
          "audit.real_eda": "NOT RUN",
          "audit.eda_calls": 0
        }
      }
    },
    {
      "op": "call",
      "tool": "evidence_emit",
      "expect": {
        "ok": true,
        "state": "EVIDENCE_EMITTED",
        "structured": {
          "evidence.real_eda": "NOT RUN",
          "evidence.eda_calls": 0
        }
      }
    },
    {
      "op": "call",
      "tool": "finalize",
      "expect": {
        "ok": true,
        "state": "FINALIZED",
        "structured": {
          "verdict": "REVIEW_REQUIRED",
          "real_eda": "NOT RUN",
          "eda_calls": 0,
          "project_writes": 0
        }
      }
    }
  ],
  "expect": {
    "outcome_class": "REVIEW_REQUIRED",
    "outcome": "REVIEW_REQUIRED (unknown device fact; report generated with verdict REVIEW_REQUIRED)",
    "final_state": "FINALIZED",
    "result_present": true,
    "verdict": "REVIEW_REQUIRED",
    "receipts_count": 5,
    "report": {
      "task.verdict": "REVIEW_REQUIRED",
      "summary.audit_status": "review_required",
      "real_eda": "NOT RUN",
      "eda_calls": 0
    }
  }
}

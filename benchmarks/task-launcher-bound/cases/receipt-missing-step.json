{
  "schema": "easycirq.bound.benchmark.case/v1",
  "id": "receipt-missing-step",
  "description": "After evidence_emit the snapshot_read receipt is deleted from receipts.jsonl; finalize detects the missing/chopped chain and refuses with RECEIPT_MISSING.",
  "setup": {
    "phase": 1,
    "backend": "fixture",
    "audit_case": "pass",
    "token": "valid"
  },
  "actions": [
    {
      "op": "call",
      "tool": "task_start",
      "expect": {
        "ok": true,
        "state": "STARTED"
      }
    },
    {
      "op": "call",
      "tool": "snapshot_read",
      "expect": {
        "ok": true,
        "state": "SNAPSHOT_READ"
      }
    },
    {
      "op": "call",
      "tool": "run_offline_audit",
      "expect": {
        "ok": true,
        "state": "AUDIT_RUN",
        "structured": {
          "finalizable": true,
          "audit.real_eda": "NOT RUN",
          "audit.eda_calls": 0
        }
      }
    },
    {
      "op": "call",
      "tool": "evidence_emit",
      "expect": {
        "ok": true,
        "state": "EVIDENCE_EMITTED",
        "structured": {
          "evidence.real_eda": "NOT RUN",
          "evidence.eda_calls": 0
        }
      }
    },
    {
      "op": "mutate_receipts",
      "mode": "drop_step",
      "step": "snapshot_read"
    },
    {
      "op": "call",
      "tool": "finalize",
      "expect": {
        "error": "RECEIPT_MISSING",
        "state": "EVIDENCE_EMITTED"
      }
    }
  ],
  "expect": {
    "outcome_class": "REJECTED",
    "outcome": "REJECTED (missing step in receipt log -> RECEIPT_MISSING)",
    "final_state": "EVIDENCE_EMITTED",
    "result_present": false,
    "receipts_count": 3,
    "evidence_present": true
  }
}

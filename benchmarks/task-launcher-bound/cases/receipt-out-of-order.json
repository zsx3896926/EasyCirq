{
  "schema": "zhigou.bound.benchmark.case/v1",
  "id": "receipt-out-of-order",
  "description": "After evidence_emit the snapshot_read and run_offline_audit receipt lines are swapped; finalize refuses the reordered chain with RECEIPT_STEP_ORDER.",
  "setup": {
    "phase": 1,
    "backend": "fixture",
    "audit_case": "pass",
    "token": "valid"
  },
  "actions": [
    {
      "op": "call",
      "tool": "task_start",
      "expect": {
        "ok": true,
        "state": "STARTED"
      }
    },
    {
      "op": "call",
      "tool": "snapshot_read",
      "expect": {
        "ok": true,
        "state": "SNAPSHOT_READ"
      }
    },
    {
      "op": "call",
      "tool": "run_offline_audit",
      "expect": {
        "ok": true,
        "state": "AUDIT_RUN",
        "structured": {
          "finalizable": true,
          "audit.real_eda": "NOT RUN",
          "audit.eda_calls": 0
        }
      }
    },
    {
      "op": "call",
      "tool": "evidence_emit",
      "expect": {
        "ok": true,
        "state": "EVIDENCE_EMITTED",
        "structured": {
          "evidence.real_eda": "NOT RUN",
          "evidence.eda_calls": 0
        }
      }
    },
    {
      "op": "mutate_receipts",
      "mode": "swap_steps",
      "steps": [
        "snapshot_read",
        "run_offline_audit"
      ]
    },
    {
      "op": "call",
      "tool": "finalize",
      "expect": {
        "error": "RECEIPT_STEP_ORDER",
        "state": "EVIDENCE_EMITTED"
      }
    }
  ],
  "expect": {
    "outcome_class": "REJECTED",
    "outcome": "REJECTED (reordered receipt chain -> RECEIPT_STEP_ORDER)",
    "final_state": "EVIDENCE_EMITTED",
    "result_present": false,
    "receipts_count": 4,
    "evidence_present": true
  }
}

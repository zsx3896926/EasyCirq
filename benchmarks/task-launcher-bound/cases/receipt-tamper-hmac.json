{
  "schema": "easycirq.bound.benchmark.case/v1",
  "id": "receipt-tamper-hmac",
  "description": "After evidence_emit an external edit flips a byte of the first receipt HMAC; finalize re-reads receipts.jsonl and refuses with RECEIPT_HMAC_INVALID.",
  "setup": {
    "phase": 1,
    "backend": "fixture",
    "audit_case": "pass",
    "token": "valid"
  },
  "actions": [
    {
      "op": "call",
      "tool": "task_start",
      "expect": {
        "ok": true,
        "state": "STARTED"
      }
    },
    {
      "op": "call",
      "tool": "snapshot_read",
      "expect": {
        "ok": true,
        "state": "SNAPSHOT_READ"
      }
    },
    {
      "op": "call",
      "tool": "run_offline_audit",
      "expect": {
        "ok": true,
        "state": "AUDIT_RUN",
        "structured": {
          "finalizable": true,
          "audit.real_eda": "NOT RUN",
          "audit.eda_calls": 0
        }
      }
    },
    {
      "op": "call",
      "tool": "evidence_emit",
      "expect": {
        "ok": true,
        "state": "EVIDENCE_EMITTED",
        "structured": {
          "evidence.real_eda": "NOT RUN",
          "evidence.eda_calls": 0
        }
      }
    },
    {
      "op": "mutate_receipts",
      "mode": "tamper_hmac"
    },
    {
      "op": "call",
      "tool": "finalize",
      "expect": {
        "error": "RECEIPT_HMAC_INVALID",
        "state": "EVIDENCE_EMITTED"
      }
    }
  ],
  "expect": {
    "outcome_class": "REJECTED",
    "outcome": "REJECTED (tampered receipt HMAC -> RECEIPT_HMAC_INVALID)",
    "final_state": "EVIDENCE_EMITTED",
    "result_present": false,
    "receipts_count": 4,
    "evidence_present": true
  }
}

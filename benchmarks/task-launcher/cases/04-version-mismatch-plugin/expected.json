{
  "schema": "zhigou.task-launcher.benchmark-case/v1",
  "id": "04-version-mismatch-plugin",
  "description": "Version handshake: request plugin version differs from the built plugin package version.",
  "launcher": {
    "agent_profile": "fake",
    "fake_scenario": "stream",
    "max_concurrent": 1,
    "claude_exe": null
  },
  "stub_args": {
    "poll_interval": 0.05,
    "timeout": 120.0,
    "cancel_after_events": 0,
    "concurrent_task_id": null
  },
  "http_status": 409,
  "final_status": null,
  "exit_code": 2,
  "checks": [
    {
      "path": "task_id",
      "equals": null
    },
    {
      "path": "start_http_status",
      "equals": 409
    },
    {
      "path": "start_status",
      "equals": null
    },
    {
      "path": "final_status",
      "equals": null
    },
    {
      "path": "result_http_status",
      "equals": null
    },
    {
      "path": "result",
      "equals": null
    },
    {
      "path": "event_count",
      "equals": 0
    },
    {
      "path": "event_seq_monotonic",
      "equals": true
    },
    {
      "path": "cancel_sent",
      "equals": false
    },
    {
      "path": "concurrent_start_http_status",
      "equals": null
    },
    {
      "path": "error.code",
      "equals": "VERSION_MISMATCH"
    },
    {
      "path": "real_eda",
      "equals": "NOT RUN"
    },
    {
      "path": "eda_calls",
      "equals": 0
    },
    {
      "path": "project_writes",
      "equals": 0
    },
    {
      "path": "agent",
      "equals": "fake"
    }
  ],
  "workspace_checks": []
}

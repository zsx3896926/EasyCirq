{
  "schema": "zhigou.task-launcher.benchmark-case/v1",
  "id": "08-timeout-stuck",
  "description": "Timeout: stuck fake agent is killed after limits.timeout_s=10; status timeout, no orphan.",
  "launcher": {
    "agent_profile": "fake",
    "fake_scenario": "stuck",
    "max_concurrent": 1,
    "claude_exe": null
  },
  "stub_args": {
    "poll_interval": 0.05,
    "timeout": 120.0,
    "cancel_after_events": 0,
    "concurrent_task_id": null
  },
  "http_status": 202,
  "final_status": "timeout",
  "exit_code": 1,
  "checks": [
    {
      "path": "start_http_status",
      "equals": 202
    },
    {
      "path": "start_status",
      "equals": "accepted"
    },
    {
      "path": "result_http_status",
      "equals": 200
    },
    {
      "path": "result.schema",
      "equals": "zhigou.task-launcher.result/v1"
    },
    {
      "path": "result.status",
      "equals": "timeout"
    },
    {
      "path": "result.mode",
      "equals": "read_only"
    },
    {
      "path": "result.agent",
      "equals": "fake"
    },
    {
      "path": "result.real_eda",
      "equals": "NOT RUN"
    },
    {
      "path": "result.eda_calls",
      "equals": 0
    },
    {
      "path": "result.project_writes",
      "equals": 0
    },
    {
      "path": "result.network_calls",
      "equals": 0
    },
    {
      "path": "result.cancelled",
      "equals": false
    },
    {
      "path": "result.timed_out",
      "equals": true
    },
    {
      "path": "cancel_sent",
      "equals": false
    },
    {
      "path": "concurrent_start_http_status",
      "equals": null
    },
    {
      "path": "error",
      "equals": null
    },
    {
      "path": "event_seq_monotonic",
      "equals": true
    },
    {
      "path": "real_eda",
      "equals": "NOT RUN"
    },
    {
      "path": "eda_calls",
      "equals": 0
    },
    {
      "path": "project_writes",
      "equals": 0
    },
    {
      "path": "agent",
      "equals": "fake"
    },
    {
      "path": "result.exit_code",
      "equals": null
    },
    {
      "path": "result.kill.killed",
      "equals": true
    }
  ],
  "workspace_checks": [
    {
      "kind": "event_count_min",
      "min": 4
    },
    {
      "kind": "event_type_present",
      "type": "timeout"
    },
    {
      "kind": "result_file_exists"
    },
    {
      "kind": "no_orphan_agent"
    }
  ]
}

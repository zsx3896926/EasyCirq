{
  "schema": "easycirq-toolchain-compat/v1",
  "name": "easycirq-toolchain",
  "version": "0.1.0",
  "protocol": "easycirq-agent/v1",
  "eda": ">=3.2.0",
  "validatedEda": "4.1.78",
  "minPython": "3.10",
  "skill": {
    "name": "easycirq",
    "dir": "easycirq"
  },
  "runtime": {
    "sourceDir": "runtime",
    "buildPackage": "./cmd/easycirq",
    "exe": "runtime/dist/easycirq.exe"
  },
  "connector": {
    "dir": "connector",
    "buildDir": "connector/build/dist"
  },
  "legal": [
    "LICENSE",
    "NOTICE"
  ],
  "notes": {
    "ports": "23111-23120",
    "stateDir": "~/.easycirq",
    "artifactsDir": "<project>/.easycirq/artifacts",
    "connectorImport": "manual only: EasyEDA Pro -> 设置 -> 扩展 -> 已安装 -> 导入扩展, then fully relaunch EasyEDA"
  },
  "python": {
    "version": "3.13.0",
    "cacheDir": "distribution/.cache/python-3.13.0-embed-amd64",
    "source": "https://mirrors.tuna.tsinghua.edu.cn/python/3.13.0/python-3.13.0-embed-amd64.zip",
    "fallbackSource": "https://www.python.org/ftp/python/3.13.0/python-3.13.0-embed-amd64.zip",
    "note": "随包分发，客户不需要自己装 Python；runtime 优先用它，PATH 上的解释器排在后面"
  }
}

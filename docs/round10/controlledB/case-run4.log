  "failures": [],
  "not_run": [],
  "waivers": [
    {
      "key": "acute-angle|I2C_SDA",
      "disposition": "accepted",
      "reason": "45-degree bend on a 400 kHz I2C signal; no acute acid-trap geometry at this angle and no current-carrying concern."
    },
    {
      "key": "antenna-keepout|U2",
      "disposition": "accepted",
      "reason": "A local all-layer no-copper region under the antenna is present; the CLI warns because its expected shape is the full board-edge band. No copper was placed under the antenna."
    },
    {
      "key": "decap-too-far|+3V3|C1",
      "disposition": "accepted",
      "reason": "C1 is the LDO 100 nF output bypass, not an MCU pin decap; the checker compares it to the nearest +3V3 pin, which is not its function."
    },
    {
      "key": "decap-too-far|+3V3|C3",
      "disposition": "accepted",
      "reason": "C3 is the 22 uF LDO output bulk capacitor; its role is regulator stability, so the 100 mil IC-decap heuristic does not apply."
    },
    {
      "key": "decap-too-far|+3V3|C4",
      "disposition": "accepted",
      "reason": "139 mil is 39 mil over the 100 mil heuristic; the part is still within about 3.5 mm of the +3V3 pin."
    },
    {
      "key": "decap-too-far|+3V3|C6",
      "disposition": "accepted",
      "reason": "140 mil is 40 mil over the heuristic and the part remains close to U2.2; accepted for the prototype."
    },
    {
      "key": "decap-too-far|+3V3|C90",
      "disposition": "accepted",
      "reason": "128 mil is 28 mil over the heuristic; this decouples a low-power I2C sensor, not a high-speed core rail."
    },
    {
      "key": "decap-too-far|+3V3|C99",
      "disposition": "accepted",
      "reason": "C99 is 272 mil (6.9 mm) from U2.2, the same position as the round9 baseline; it is tied to +3V3 and the GND pour. Accepted for the prototype; recheck if the rail shows transient noise."
    },
    {
      "key": "duplicate-segment|+3V3",
      "disposition": "accepted",
      "reason": "The official router left one 17 mil collinear overlap on +3V3; it is redundant copper, not an open or short. Accepted for the prototype; recheck if the net is rerouted."
    },
    {
      "key": "parallel-coupling|BOOT|EN",
      "disposition": "accepted",
      "reason": "Both nets are low-speed static/diagnostic; the 28.8 mil gap is 1.2 mil below the 3W heuristic over a 41 mil run."
    },
    {
      "key": "parallel-coupling|CC1|USB_DP_CONN",
      "disposition": "accepted",
      "reason": "CC1 is a DC configuration signal; coupling into a 25 mil DP run is negligible at full speed."
    },
    {
      "key": "parallel-coupling|USB_DM_MCU|USB_DP_CONN",
      "disposition": "accepted",
      "reason": "Full-speed USB (12 Mbps) prototype; the 29 mil coupled run is short and no high-speed SI signoff was claimed."
    },
    {
      "key": "parallel-coupling|USB_DP_CONN|VBUS_5V",
      "disposition": "accepted",
      "reason": "Short 21 mil parallel run between a power rail and DP; prototype-level risk accepted without SI signoff."
    },
    {
      "key": "power-not-poured|+3V3",
      "disposition": "accepted",
      "reason": "+3V3 is a low-current rail carried by sized tracks; the board keeps a solid GND pour. Pouring +3V3 was not justified by current."
    },
    {

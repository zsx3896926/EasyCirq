      "core": "upper",
      "roles": {
        "upper": [
          "supply",
          "tap"
        ],
        "lower": [
          "tap",
          "ground"
        ]
      },
      "placements": [
        {
          "role": "lower",
          "pin": "tap",
          "relativeTo": "upper",
          "targetPin": "tap",
          "side": "below"
        }
      ],
      "connections": [
        [
          "upper.tap",
          "lower.tap"
        ]
      ],
      "checks": [
        "Vertical upper/lower chain; branch tap to destination input. Verify ratio, loading and power separately."
      ]
    },

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zsx3896926/hardware-design-skill/protocol/schemas/artifact.schema.json",
  "title": "artifact",
  "type": "object",
  "required": [
    "id",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "mimeType": {
      "type": "string"
    },
    "fileName": {
      "type": "string"
    },
    "inlineBase64": {
      "type": "string",
      "description": "connector -> daemon only; stripped before returning to the caller"
    },
    "path": {
      "type": "string",
      "description": "daemon -> caller only; absolute path of the persisted file"
    },
    "size": {
      "type": "integer"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}

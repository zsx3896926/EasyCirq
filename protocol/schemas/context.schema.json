{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zsx3896926/hardware-design-skill/protocol/schemas/context.schema.json",
  "title": "context (connector -> daemon)",
  "type": "object",
  "required": [
    "type",
    "windowId"
  ],
  "properties": {
    "type": {
      "const": "context"
    },
    "windowId": {
      "type": "string"
    },
    "projectUuid": {
      "type": "string"
    },
    "projectName": {
      "type": "string"
    },
    "documentUuid": {
      "type": "string"
    },
    "documentType": {
      "type": "string"
    },
    "tabId": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "pageVisibility": {
      "type": "string",
      "enum": [
        "visible",
        "hidden",
        "prerender",
        "unknown"
      ]
    }
  },
  "additionalProperties": true
}

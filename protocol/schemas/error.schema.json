{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zsx3896926/EasyCirq/protocol/schemas/error.schema.json",
  "title": "error",
  "type": "object",
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "UNKNOWN_ACTION",
        "MISSING_PAYLOAD_FIELD",
        "EDA_API_UNAVAILABLE",
        "EDA_CALL_FAILED",
        "INVALID_STATE",
        "INTERNAL_ERROR",
        "ACTION_ABANDONED",
        "QUEUE_OVERFLOW",
        "PRECONDITION_REFUSED",
        "NO_CONNECTOR",
        "STALE_WINDOW",
        "AMBIGUOUS_WINDOW",
        "AMBIGUOUS_PROJECT",
        "DISPATCH_FAILED",
        "TIMEOUT"
      ],
      "description": "stable code; consumers must not depend on message text"
    },
    "message": {
      "type": "string"
    },
    "detail": {
      "type": "string",
      "description": "original host error preserved verbatim"
    }
  },
  "additionalProperties": true
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zsx3896926/EasyCirq/protocol/schemas/request.schema.json",
  "title": "request (daemon -> connector)",
  "type": "object",
  "required": [
    "type",
    "id",
    "action"
  ],
  "properties": {
    "type": {
      "const": "request"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "request id; unique per dispatch, used for dedupe and audit"
    },
    "version": {
      "const": "v1"
    },
    "action": {
      "type": "string",
      "description": "typed action name from `easycirq actions`"
    },
    "payload": {
      "type": "object"
    },
    "windowId": {
      "type": "string",
      "description": "explicit target; required when more than one window is connected"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "description": "caller round-trip budget; the connector abandons the queue head after it"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
